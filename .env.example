# ---- Database ----
# Local development uses SQLite (zero setup):
DATABASE_URL="file:./dev.db"

# Production / staging uses PostgreSQL. To switch:
#   1. Set DATABASE_URL below
#   2. Change `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma
#   3. Run: npx prisma migrate dev --name init   (or npx prisma migrate deploy)
# DATABASE_URL="postgresql://user:password@host:5432/africinnovate_assessment?schema=public"

# --- Auth ---
AUTH_SECRET="replace-with-openssl-rand-base64-48"

# --- App ---
APP_URL="http://localhost:3000"

# --- Email (optional; Resend-compatible adapter) ---
EMAIL_PROVIDER_API_KEY=""
EMAIL_PROVIDER_URL="https://api.resend.com/emails"
EMAIL_FROM="Africinnovate <notifications@africinnovate.com>"

# --- AI-assisted rubric scoring (OpenAI-compatible chat completions) ---
# The admin presses "Suggest score with AI"; a staff member must still review it.
AI_SCORING_API_KEY=""
AI_SCORING_API_URL="https://api.openai.com/v1/chat/completions"
AI_SCORING_MODEL="gpt-4o-mini"
AI_SCORING_TIMEOUT_MS="30000"
